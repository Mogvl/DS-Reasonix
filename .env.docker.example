# =============================================================================
# DS-Reasonix Docker 部署环境变量示例
# 复制为 .env 后填写：  cp .env.docker.example .env
# =============================================================================

# ---- 必填：DeepSeek API 密钥（https://platform.deepseek.com 获取）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 可选：监听端口（默认 前端 7551 / 后端 7552）----
# 注意：容器内部后端端口固定为 7552（nginx 依赖它），这里只改宿主机映射端口
# WEB_PORT=7551
# BACKEND_PORT=7552

# ---- 可选：Web 访问鉴权（默认 token）----
# 三种模式：none | token | password
REASONIX_SERVE_AUTH=token
# token 模式：留空则每次启动随机生成（看 docker logs 里的 share 链接）
REASONIX_SERVE_TOKEN=
# password 模式：设置固定密码（打开 http://NAS:7551/login 登录）
# REASONIX_SERVE_AUTH=password
# REASONIX_SERVE_PASSWORD=change-me

# ---- 可选：是否位于反向代理之后（nginx 前端默认会带上 X-Forwarded-* 头）----
REASONIX_SERVE_BEHIND_PROXY=true

# ---- 可选：时区 ----
TZ=Asia/Shanghai

# ---- 可选：国内网络构建镜像时使用 goproxy.cn（仅 docker compose up --build 时需要）----
# GOPROXY=https://goproxy.cn,direct
